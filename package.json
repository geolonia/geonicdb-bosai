{
  "name": "geonicdb-bosai",
  "version": "0.1.0",
  "private": true,
  "description": "自治体向け防災サイトのテンプレート（Next.js + GeonicDB）",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/externalize-inline-scripts.mjs && node scripts/assert-pwa-manifest.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:a11y": "vitest run src/components/top/a11y.test.tsx",
    "test:cdk": "npm test --prefix infra/cdk",
    "lighthouse": "npm run build && lhci autorun",
    "setup:geonicdb": "bash scripts/setup-geonicdb.sh"
  },
  "dependencies": {
    "@geolonia/geonicdb-sdk": "^0.18.1",
    "markdown-to-jsx": "^9.10.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "serve": "^14.2.6",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  }
}
