# GeonicDB（職員向け管理・書き込み経路用。CLI / 将来の管理画面）
# 例: https://geonicdb.geolonia.com
GEONICDB_URL=

# 書き込み用 API キー（任意。gdb_ 接頭辞または UUID 形式）
# npm run setup:geonicdb で作成する bosai-staff-write を想定
GEONICDB_API_KEY=

# テナント名（任意。小文字英数字とアンダースコアのみ。UUID の tenantId ではない）
GEONICDB_TENANT=

# --- 住民向け公開ページ（クライアント埋め込み・匿名読み取り専用）---
# 秘密情報ではない（ベース URL とテナント名のみ。API キーは埋め込まない）
# 読み取りはサーバー側 XACML ポリシー bosai-public-read で制御する（REQUIREMENTS.md 2.1）
NEXT_PUBLIC_GEONICDB_URL=https://geonicdb.geolonia.com
NEXT_PUBLIC_GEONICDB_TENANT=miya
