# GeonicDB（職員向け管理・書き込み経路用。CLI / 将来の管理画面）
# 例: https://geonicdb.geolonia.com
GEONICDB_URL=

# 書き込み用 API キー（任意。gdb_ 接頭辞または UUID 形式）
# npm run setup:geonicdb で作成する bosai-staff-write を想定
GEONICDB_API_KEY=

# テナント名（任意。小文字英数字とアンダースコアのみ。UUID の tenantId ではない）
GEONICDB_TENANT=

# --- 住民向け公開ページ（クライアント埋め込み）---
# URL・テナント名は秘密情報ではない。REST読み取りは匿名モード + サーバー側XACML
# ポリシー bosai-public-read で制御する（REQUIREMENTS.md 2.1）
NEXT_PUBLIC_GEONICDB_URL=https://geonicdb.geolonia.com
NEXT_PUBLIC_GEONICDB_TENANT=miya

# WebSocketでのリアルタイム更新購読用のAPIキー（任意）。
# SDKの connect() は匿名モードでは使えない（トークンが必要）ため、WS購読にはこのキーが要る。
#
# **重要: このキーはクライアントバンドルに含まれ第三者から見える。**
# 以下の条件をすべて満たすキーだけを設定すること（作成手順は docs/geonicdb-setup.md）:
#   - bosai-read ポリシー（GET + WS のみ。書き込みは 403 で拒否される）
#   - DPoP 必須（--dpop-required）
#   - オリジン限定（--origins にサイトの実ドメイン。ワイルドカード '*' にしない）
# bosai-write 系（エンティティ書き込み可）は絶対に設定しないこと。
#
# 未設定の場合、WS購読はスキップされ、REST読み取り（匿名モード）のみで動作する。
NEXT_PUBLIC_GEONICDB_WS_API_KEY=

# Web Push 購読登録用の API キー（任意。#39）。
# ブラウザから GeonicDB `/ngsi-ld/v1/subscriptions` へ直接 POST/DELETE する。
# 中間 Lambda / プロキシは不要。
#
# **重要: クライアントバンドルに埋め込まれる。** 次を満たすキーのみ:
#   - キー名: bosai-webpush-subscribe（このキーの「値」をここに設定する）
#   - 付与ポリシー: bosai-webpush-proxy-write
#     （subscriptions の POST/DELETE/GET + bosai-* の GET。エンティティ書き込み不可。
#      配信時認可のため対象エンティティ GET が必須 — docs/geonicdb-setup.md）
#   - DPoP 必須・オリジン限定・rateLimit.perMinute=30
# bosai-write（エンティティ書き込み可）は絶対に設定しないこと。
# 未設定の場合、通知オプトイン UI は表示されない。
NEXT_PUBLIC_GEONICDB_WEBPUSH_API_KEY=
