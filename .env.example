# GeonicDB（職員向け管理・書き込み経路用。CLI / 将来の管理画面）
# 例: https://geonicdb.geolonia.com
GEONICDB_URL=

# 書き込み用 API キー（任意。gdb_ 接頭辞または UUID 形式）
# npm run setup:geonicdb で作成する bosai-staff-write を想定
GEONICDB_API_KEY=

# テナント名（任意。小文字英数字とアンダースコアのみ。UUID の tenantId ではない）
GEONICDB_TENANT=

# --- 住民向け公開ページ（クライアント埋め込み）---
# URL・テナント名は秘密情報ではない。REST読み取りは匿名モード + サーバー側XACML
# ポリシー bosai-public-read で制御する（REQUIREMENTS.md 2.1）
NEXT_PUBLIC_GEONICDB_URL=https://geonicdb.geolonia.com
NEXT_PUBLIC_GEONICDB_TENANT=miya

# WebSocketでのリアルタイム更新購読用のAPIキー（任意）。
# SDKの connect() は匿名モードでは使えないため、WS購読にはこのキーが必要。
# **重要: このキーはクライアントバンドルに含まれ第三者から見える。**
# bosai-read ポリシー（GET + WS のみ、書き込み不可）を付与した読み取り専用キーだけを
# 設定すること。bosai-write 系の書き込み可能なキーは絶対に設定しないこと。
# 未設定の場合、WS購読はスキップされ、REST読み取り（匿名モード）のみで動作する。
NEXT_PUBLIC_GEONICDB_WS_API_KEY=
